{
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/suno-audio/:clipId",
      "destination": "/api/suno-audio?clipId=:clipId"
    },
    {
      "source": "/api/suno-rights/:clipId",
      "destination": "/api/suno-rights?clipId=:clipId"
    },
    {
      "source": "/api/verified-chords/:videoId",
      "destination": "/api/verified-chords?videoId=:videoId"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
