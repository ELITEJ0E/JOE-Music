{
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/youtube/",
      "destination": "https://chord-extractor.joel-tan.prod.page/"
    },
    {
      "source": "/api/youtube",
      "destination": "https://chord-extractor.joel-tan.prod.page/"
    },
    {
      "source": "/api/youtube/health",
      "destination": "https://chord-extractor.joel-tan.prod.page/health"
    },
    {
      "source": "/api/youtube/:path*",
      "destination": "https://chord-extractor.joel-tan.prod.page/:path*"
    },
    {
      "source": "/api/suno-audio/:clipId",
      "destination": "/api/suno-audio?clipId=:clipId"
    },
    {
      "source": "/api/suno-rights/:clipId",
      "destination": "/api/suno-rights?clipId=:clipId"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
